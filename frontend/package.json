{
  "name": "fullstack-b2b-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "predev": "bun run api:generate",
    "build": "tsc && vite build",
    "prebuild": "bun run api:generate",
    "preview": "vite preview",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives",
    "prelint": "bun run api:generate",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\"",
    "typecheck": "tsc --noEmit",
    "pretypecheck": "bun run api:generate",
    "doctor": "npx react-doctor@latest",
    "check-conventions": "bun run scripts/check_conventions.ts",
    "check-dependencies": "bun run scripts/check_dependencies.ts",
    "api:generate": "openapi-ts",
    "api:check": "OPENAPI_OUTPUT=src/api/.generated-check openapi-ts && (diff -r src/api/generated src/api/.generated-check; s=$?; rm -rf src/api/.generated-check; exit $s)",
    "gauntlet": "bun run lint && bun run typecheck && bun run check-conventions && bun run check-dependencies && bun run api:check"
  },
  "dependencies": {
    "@tanstack/react-query": "5.51.1",
    "@tanstack/react-query-devtools": "5.51.1",
    "axios": "1.7.0",
    "clsx": "2.1.1",
    "react": "19.0.1",
    "react-dom": "19.0.1",
    "react-router-dom": "7.1.0",
    "tailwind-merge": "2.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@hey-api/openapi-ts": "0.99.0",
    "@types/react": "19.0.0",
    "@types/react-dom": "19.0.0",
    "@typescript-eslint/eslint-plugin": "7.14.0",
    "@typescript-eslint/parser": "7.14.0",
    "@vitejs/plugin-react": "4.3.1",
    "autoprefixer": "10.4.19",
    "eslint": "8.57.0",
    "eslint-plugin-react-hooks": "4.6.2",
    "eslint-plugin-react-refresh": "0.4.8",
    "postcss": "8.4.39",
    "prettier": "3.3.2",
    "prettier-plugin-tailwindcss": "0.6.5",
    "react-doctor": "0.2.9",
    "tailwindcss": "3.4.4",
    "typescript": "5.5.2",
    "vite": "5.3.2"
  }
}
