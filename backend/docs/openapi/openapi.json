  "components": {
    "schemas": {
      "UserSchema": {
        "description": "User response schema.",
        "properties": {
          "id": {
            "title": "Id",
            "type": "integer"
          },
          "email": {
            "format": "email",
            "title": "Email",
            "type": "string"
          },
          "username": {
            "title": "Username",
            "type": "string"
          },
          "first_name": {
            "default": "",
            "title": "First Name",
            "type": "string"
          },
          "last_name": {
            "default": "",
            "title": "Last Name",
            "type": "string"
          },
          "avatar_url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Avatar Url"
          },
          "bio": {
            "default": "",
            "title": "Bio",
            "type": "string"
          },
          "is_active": {
            "default": true,
            "title": "Is Active",
            "type": "boolean"
          },
          "date_joined": {
            "format": "date-time",
            "title": "Date Joined",
            "type": "string"
          }
        },
        "required": [
          "id",
          "email",
          "username",
          "date_joined"
        ],
        "title": "UserSchema",
        "type": "object"
      },
      "UserCreateSchema": {
        "description": "User registration schema.",
        "properties": {
          "email": {
            "format": "email",
            "title": "Email",
            "type": "string"
          },
          "username": {
            "maxLength": 150,
            "minLength": 3,
            "title": "Username",
            "type": "string"
          },
          "password": {
            "minLength": 8,
            "title": "Password",
            "type": "string"
          },
          "first_name": {
            "default": "",
            "title": "First Name",
            "type": "string"
          },
          "last_name": {
            "default": "",
            "title": "Last Name",
            "type": "string"
          }
        },
        "required": [
          "email",
          "username",
          "password"
        ],
        "title": "UserCreateSchema",
        "type": "object"
      },
      "TokenSchema": {
        "description": "Token response schema.",
        "properties": {
          "access_token": {
            "title": "Access Token",
            "type": "string"
          },
          "refresh_token": {
            "title": "Refresh Token",
            "type": "string"
          },
          "token_type": {
            "default": "bearer",
            "title": "Token Type",
            "type": "string"
          }
        },
        "required": [
          "access_token",
          "refresh_token"
        ],
        "title": "TokenSchema",
        "type": "object"
      },
      "LoginSchema": {
        "description": "Login request schema.",
        "properties": {
          "email": {
            "format": "email",
            "title": "Email",
            "type": "string"
          },
          "password": {
            "title": "Password",
            "type": "string"
          }
        },
        "required": [
          "email",
          "password"
        ],
        "title": "LoginSchema",
        "type": "object"
      },
      "RefreshTokenSchema": {
        "description": "Refresh token request schema.",
        "properties": {
          "refresh_token": {
            "title": "Refresh Token",
            "type": "string"
          }
        },
        "required": [
          "refresh_token"
        ],
        "title": "RefreshTokenSchema",
        "type": "object"
      },
      "UserUpdateSchema": {
        "description": "User update schema.",
        "properties": {
          "first_name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "First Name"
          },
          "last_name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Last Name"
          },
          "avatar_url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Avatar Url"
          },
          "bio": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Bio"
          }
        },
        "title": "UserUpdateSchema",
        "type": "object"
